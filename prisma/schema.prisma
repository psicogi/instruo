generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Instrutor {
    id            String   @id @default(cuid())
    nome          String
    email         String   @unique
    telefone      String?
    bio           String?
    avatarUrl     String?
    credenciado   Boolean  @default(false)
    raioKm        Int      @default(15)
    pixChave      String?
    createdAt     DateTime @default(now())

    bairros      BairroInstrutor[]
    veiculos     Veiculo[]
    pacotes      Pacote[]
    agendamentos Agendimento[]
    bloqueios    Bloqueio[]
}

model BairroInstrutor {
    id          String    @id @default(cuid())
    instrutorId String
    nome        String
    instrutor   Instrutor @relation(fields: [instrutorId], references: [id])
}

model Veiculo {
    id          String      @id @default(cuid())
    instrutorId String
    tipo        TipoVeiculo
    modelo      String
    categoriaCnh CategoriaCnh
    valorAula   Float
    ativo       Boolean     @default(true)

    instrutor     Instrutor     @relation(fields: [instrutorId], references: [id])
    pacotes       Pacote[]
    agendamentos  Agendamento[]
}

model Pacote {
    id            String  @id @default(cuid())
    instrutorId   String
    veiculoId     String
    nome          String          // ex: "Pacote 5 aulas"
    quantidadeAulas Int
    valorTotal    Float
    ativo         Boolean @default(true)

    instrutor    Instrutor     @relation(fields: [instrutorId], references: [id])
    veiculo      Veiculo       @relation(fields: [veiculoId], references: [id])
    compras      Compra[]
}

model Cliente {
    id        String   @id @default(cuid())
    nome      String
    email     String   @unique
    telefone  String?
    createdAt DateTime @default(now())

    enderecos    Endereco[]
    compras      Compra[]
    agendamentos Agendamento[]
}

model Endereco {
    id          String  @id @default(cuid())
    clienteId   String
    rua         String
    numero      String
    complemento String?
    bairro      String
    cidade      String
    cep         String
    padrao      Boolean @default(false)

    cliente      Cliente       @relation(fields: [clienteId], references: [id])
    agendamentos Agendamento[]
}

model Compra {
    id              String       @id @default(cuid())
    clienteId       String
    pacoteId        String
    valorPago       Float
    statusPagamento StatusPagamento @default(PENDENTE)
    metodoPagamento MetodoPagamento?
    mpPaymentId     String?       // ID do Mercado Pago
    createdAt       DateTime     @default(now())

    cliente      Cliente       @relation(fields: [clienteId], references: [id])
    pacote       Pacote        @relation(fields: [pacoteId], references: [id])
    agendamentos Agendamento[]
}

model Agendamento {
    id            String   @id @default(cuid())
    compraId      String
    clienteId     String
    instrutorId   String
    veiculoId     String
    enderecoId    String
    numeroAula    Int               // ex: 1, 2, 3...
    dataHora      DateTime
    duracaoMin    Int      @default(50)
    retornoMesmoEnd Boolean @default(true)
    observacao    String?
    status        StatusAgendamento @default(PENDENTE)
    createdAt     DateTime @default(now())

    compra      Compra    @relation(fields: [compraId], references: [id])
    cliente     Cliente   @relation(fields: [clienteId], references: [id])
    instrutor   Instrutor @relation(fields: [instrutorId], references: [id])
    veiculo     Veiculo   @relation(fields: [veiculoId], references: [id])
    endereco    Endereco  @relation(fields: [enderecoId], references: [id])
}

model Bloqueio {
    id          String    @id @default(cuid())
    instrutorId String
    inicio      DateTime
    fim         DateTime
    motivo      String?

    instrutor   Instrutor @relation(fields: [instrutorId], references: [id])
}

enum TipoVeiculo {
    CARRO
    MOTO
}

enum CategoriaCnh {
    A
    B
    C
    D
    E
}

enum StatusPagamento {
    PENDENTE
    PAGO
    CANCELADO
    REEMBOLSADO
}

enum MetodoPagamento {
    PIX
    CARTAO
    BOLETO
}