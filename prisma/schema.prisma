generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Instrutor {
    id            String   @id @default(cuid())
    nome          String
    email         String   @unique
    telefone      String?
    bio           String?
    avatarUrl     String?
    credenciado   Boolean  @default(false)
    raioKm        Int      @default(15)
    pixChave      String?
    createdAt     DateTime @default(now())

    bairros      BairroInstrutor[]
    veiculos     Veiculo[]
    pacotes      Pacote[]
    // agendamentos Agendimento[]
    // bloqueios    Bloqueio[]
}

model BairroInstrutor {
    id          String    @id @default(cuid())
    instrutorId String
    nome        String
    instrutor   Instrutor @relation(fields: [instrutorId], references: [id])
}

model Veiculo {
  id          String      @id @default(cuid())
  instrutorId String
  tipo        TipoVeiculo
  modelo      String
  categoriaCnh CategoriaCnh
  valorAula   Float
  ativo       Boolean     @default(true)

  instrutor     Instrutor     @relation(fields: [instrutorId], references: [id])
  pacotes       Pacote[]
  // agendamentos  Agendamento[]
}

model Pacote {
  id            String  @id @default(cuid())
  instrutorId   String
  veiculoId     String
  nome          String          // ex: "Pacote 5 aulas"
  quantidadeAulas Int
  valorTotal    Float
  ativo         Boolean @default(true)

  instrutor    Instrutor     @relation(fields: [instrutorId], references: [id])
  veiculo      Veiculo       @relation(fields: [veiculoId], references: [id])
  // compras      Compra[]
}